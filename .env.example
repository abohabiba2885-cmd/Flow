# Copy to .env and fill in. Never commit the real .env.
BASE_URL=https://frontend.aws-stage.flowsky.co

# Authentication: use ONE of the two options.
# Option 1 - credential login in fixtures/global-setup.ts (writes .auth/user.json).
# Maker user with permission to create and edit loan product configuration (placeholders only)
FLOWSKY_EMAIL=your.maker.user@example.com
FLOWSKY_PASSWORD=change-me
# Option 2 - a session recorded with: npx playwright codegen --save-storage=.auth/user.json <BASE_URL>/login
# When set, the credential login is skipped.
PLAYWRIGHT_STORAGE_STATE=

# Optional: a second user WITHOUT loan-product edit permission (authorization tests)
FLOWSKY_RESTRICTED_EMAIL=
FLOWSKY_RESTRICTED_PASSWORD=

# Controlled, QA-owned loan product used by Edit tests (numeric id from /loan-product-config/edit/{id}).
# Use a dedicated record - Edit tests change it. Do not point this at a production-like or shared product.
EDIT_PRODUCT_ID=

# QA-owned product with NO associated workflow (Step 5 Pending). Needed by FLOW-LPC-EDIT-S05-002 and FLOW-LPC-EDIT-S10-001.
# Those tests associate a workflow and submit the product for review, so provide a fresh product for each run.
EDIT_PRODUCT_ID_NO_WORKFLOW=

# Prefix for products created by Add tests (helps cleanup and search)
TEST_PRODUCT_PREFIX=QA-LPC

# Legacy alias for BASE_URL used by the step suites migrated from Flow. Leave empty unless needed.
LOAN_PRODUCT_APP_URL=

# Set to true only when EDIT_PRODUCT_ID is an approved (previously submitted) QA-owned product.
# Enables FR-MC-019 (change banner, Discard, Submit for Review). Leave false for a draft.
EDIT_PRODUCT_APPROVED=false

# --- Merchant module (Merchants Management System). Not used by any spec yet; see docs/merchant-module-access.md.
MMS_BASE_URL=https://mms-staging.flowsky.co
# Merchant-side users on MMS staging (placeholders only)
MMS_MERCHANT_ADMIN_EMAIL=
MMS_MERCHANT_ADMIN_PASSWORD=
MMS_BRANCH_MANAGER_EMAIL=
MMS_BRANCH_MANAGER_PASSWORD=
MMS_SALES_PERSON_EMAIL=
MMS_SALES_PERSON_PASSWORD=
# Flow back-office users for merchant oversight (placeholders only)
FLOW_ACQUISITION_OFFICER_EMAIL=
FLOW_ACQUISITION_OFFICER_PASSWORD=
FLOW_ACQUISITION_MANAGER_EMAIL=
FLOW_ACQUISITION_MANAGER_PASSWORD=
FLOW_FINANCE_OFFICER_EMAIL=
FLOW_FINANCE_OFFICER_PASSWORD=
FLOW_COMPLIANCE_OFFICER_EMAIL=
FLOW_COMPLIANCE_OFFICER_PASSWORD=
# QA-owned test data ids on staging
MMS_MERCHANT_ID=
MMS_BRANCH_ID=
MMS_CUSTOMER_NATIONAL_ID=
